# ===========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control

# ===========================================
# DATABASE (Render PostgreSQL)
# ===========================================
# DATABASE_URL is automatically provided by Render via render.yaml
# No need to set manually - Render injects this environment variable

# ===========================================
# REDIS (Render Redis)
# ===========================================
# REDIS_HOST and REDIS_PORT are automatically provided by Render via render.yaml

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Generate a secure random string: https://randomkeygen.com/
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRATION=7d

# ===========================================
# APPLICATION
# ===========================================
NODE_ENV=production
PORT=3000

# ===========================================
# SECURITY
# ===========================================
BCRYPT_ROUNDS=12

# ===========================================
# CORS (Your Vercel Frontend URL)
# ===========================================
# Format: https://your-app.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# ===========================================
# RATE LIMITING
# ===========================================
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# ===========================================
# ESCROW SETTINGS
# ===========================================
ESCROW_AUTO_RELEASE_DAYS=7

# ===========================================
# AFRICA'S TALKING (SMS)
# ===========================================
# Get these from: Africa's Talking Dashboard → Settings → API Key
AFRICA_TALKING_API_KEY=your_api_key_here
AFRICA_TALKING_USERNAME=sandbox